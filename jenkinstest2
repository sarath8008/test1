pipeline {
    agent any  // Runs on any available agent

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/your-repo.git'
            }
        }

        stage('Build') {
            steps {
                script {
                    echo "Building the project..."
                    sh './gradlew build'  // Modify this for your build tool (e.g., Maven, npm, etc.)
                }
            }
        }

        stage('Welcome') {
            steps {
                script {
                    echo "Welcome! Build completed successfully."
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline execution completed."
        }
    }
}
